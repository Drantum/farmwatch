# Kamerastreams (RTSP Adressen der Kameras im lokalen Netzwerk)
LKW_CAM_RTSP=rtsp://admin:password@192.168.1.100:554/h264Preview_01_main
KALB_CAM_RTSP=rtsp://admin:password@192.168.1.101:554/h264Preview_01_main

# go2rtc Server (Adresse im Docker-Netzwerk bzw. Host)
GO2RTC_HOST=go2rtc
GO2RTC_HTTP_PORT=1984
GO2RTC_RTSP_PORT=8554

# Optionale Speditionserkennung (OpenAI-kompatible Vision API)
VISION_ENABLED=false
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
